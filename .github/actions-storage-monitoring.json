{
  "schema_version": 3,
  "repository": "Shahbazi-Amir/Project_Brain_Master",
  "scope": "repository_local_only",
  "cleanup": {
    "workflow_path": ".github/workflows/actions-artifact-retention.yml",
    "workflow_mode": "manual_only",
    "skip_active_or_queued_repositories": true,
    "delete_workflow_runs": false,
    "delete_logs": false
  },
  "external_control_center": {
    "embedded": false,
    "note": "GitHub Control Center is a separate private/local project and is not part of Project Brain runtime."
  }
}
